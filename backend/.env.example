# Database (e.g., Supabase transaction pooler URL)
DATABASE_URL=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Redis
REDIS_HOST=redis-12758.c301.ap-south-1-1.ec2.cloud.redislabs.com
REDIS_PORT=12758
REDIS_PASSWORD=paste_your_redis_password_here

# Segmenter Agent
SEGMENTER_MODEL=llama-3.3-70b-versatile
SEGMENTER_BASE_URL=https://api.groq.com/openai/v1
SEGMENTER_API_KEY=gsk_your_groq_key
SEGMENTER_TEMPERATURE=0.1
SEGMENTER_MAX_TOKENS=2000

# Extractor Agent
EXTRACTOR_MODEL=llama-3.3-70b-versatile
EXTRACTOR_BASE_URL=https://api.groq.com/openai/v1
EXTRACTOR_API_KEY=gsk_your_groq_key
EXTRACTOR_TEMPERATURE=0.0
EXTRACTOR_MAX_TOKENS=4000

# Index Keeper Agent
INDEX_KEEPER_MODEL=llama-3.3-70b-versatile
# IMPORTANT: Do NOT use a prompt-guard/safeguard model here — needs a generative chat model
INDEX_KEEPER_BASE_URL=https://api.groq.com/openai/v1
INDEX_KEEPER_API_KEY=gsk_your_groq_key
INDEX_KEEPER_TEMPERATURE=0.0
INDEX_KEEPER_MAX_TOKENS=100

# Note Author Agent
NOTE_AUTHOR_MODEL=llama-3.3-70b-versatile
NOTE_AUTHOR_BASE_URL=https://api.groq.com/openai/v1
NOTE_AUTHOR_API_KEY=gsk_your_groq_key
NOTE_AUTHOR_TEMPERATURE=0.3
NOTE_AUTHOR_MAX_TOKENS=8000

# Reviewer Agent
REVIEWER_MODEL=llama-3.3-70b-versatile
REVIEWER_BASE_URL=https://api.groq.com/openai/v1
REVIEWER_API_KEY=gsk_your_groq_key
REVIEWER_TEMPERATURE=0.2
REVIEWER_MAX_TOKENS=2000

# Diagram Agent
DIAGRAM_AGENT_MODEL=llama-3.3-70b-versatile
# IMPORTANT: Do NOT use a safeguard model here — needs a generative chat model
DIAGRAM_AGENT_BASE_URL=https://api.groq.com/openai/v1
DIAGRAM_AGENT_API_KEY=gsk_your_groq_key
DIAGRAM_AGENT_TEMPERATURE=0.2
DIAGRAM_AGENT_MAX_TOKENS=3000

# Embedding
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Index Keeper Thresholds
SIMILARITY_HIGH_THRESHOLD=0.88
SIMILARITY_LOW_THRESHOLD=0.35

# Pipeline Config
PATCH_SIZE=2
MAX_REVIEWER_RETRIES=1
MAX_DIAGRAMS_PER_NOTE=3

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=your-anon-key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_MAX_PER_WEEK=2
RATE_LIMIT_ADMIN_MAX_PER_WEEK=-1
RATE_LIMIT_RETRY_MAX_PER_SOURCE=3

# Admin
ADMIN_EMAILS=admin@example.com,admin2@example.com

# Error Handling
SENTRY_DSN=
LOG_LEVEL=INFO
